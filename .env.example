# Leave EAGLE_AGENT_ID blank -> app runs in MOCK mode (desk works, scripted demo).
# Fill all four -> REAL mode (connects to the Eagle orchestrator session).

ANTHROPIC_API_KEY=
EAGLE_AGENT_ID=        # id from: ant apply eagle-orchestrator.md
ENV_ID=               # managed-agents environment id
VAULT_IDS=            # comma-separated vault ids for MCP auth (optional)
